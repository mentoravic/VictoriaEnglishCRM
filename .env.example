# ============================================================
#  CRM școală — configurare (doar variabilele folosite de aplicație)
#  Completează câmpurile goale. Verifică cu: npm run env:check
# ============================================================

# ── OBLIGATORII ─────────────────────────────────────────────

# MongoDB — numele bazei de date trebuie inclus în URL (înainte de ?)
DATABASE_URL="mongodb+srv://USER:PAROLA@cluster.mongodb.net/NUME_BAZA?retryWrites=true&w=majority"

# Adresa aplicației (local: http://localhost:3000, în producție: domeniul real)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Chei secrete — comenzile de generare sunt în README
NEXTAUTH_SECRET=""
ENCRYPTION_KEY=""
CRON_SECRET=""

# Numele afișat în Google Authenticator la activarea 2FA
TOTP_APP_NAME="Mentora"

# ── CONTURI INIȚIALE (npm run db:seed) ──────────────────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_EMAIL=""
SEED_TEACHER_PASSWORD=""

# ── TELEGRAM (notificări) ───────────────────────────────────
# Un singur bot, într-un grup cu Topics activate (botul = admin cu "Manage topics").
# ID-urile topic-urilor (TELEGRAM_*_THREAD_ID) se adaugă automat în acest fișier
# de: npm run telegram:topics
TELEGRAM_LESSONS_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""
# Username-ul botului, fără @ (pentru linkul de conectare a conturilor)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Chat ID-uri (separate prin virgulă) care primesc copie la mesajele către profesori
TELEGRAM_SUPERVISOR_CHAT_IDS=""
